ENV=production
SECRET_KEY=change-me-to-a-random-32-char-string
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://signaliq_app:signaliq_app@postgres:5432/signaliq
DATABASE_URL_SYNC=postgresql://signaliq:signaliq@postgres:5432/signaliq

JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7

API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000

# LLM provider keys — the user brings their own.
# At least one is required for generation.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# External data — optional
FRED_API_KEY=
SEC_USER_AGENT=SignalIQ (contact@example.com)
STOCK_NEWS_FETCH_CONTENT=false
FOOTBALL_DATA_API_KEY=
THE_ODDS_API_KEY=

REDIS_URL=redis://redis:6379/0

PRODUCT_URL=https://signaliq.com

# Set false to skip alembic on API startup (read replicas / tests)
RUN_MIGRATIONS_ON_STARTUP=true
